ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# Which models a served turn uses (convint serve / mcp / turn). The operator
# decides; callers can only force the free deterministic assessor.
# Assessor: deterministic | llm:<key> | hybrid:<key>   (default hybrid:haiku-4-5)
CONVINT_ASSESSOR=
# Model for the next question and the Read: a registry key, or `none` to return
# decisions only (message/artifact null). Default haiku-4-5.
CONVINT_MODEL=
